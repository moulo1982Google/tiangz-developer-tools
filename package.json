{
  "name": "@tiangz/developer-tools-core",
  "version": "0.9.1",
  "description": "TiangZ 工程模型、静态索引与 VS Code 开发工具",
  "author": "moulo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/eblard_admin/tiangz-developer-tools.git"
  },
  "type": "module",
  "main": "./packages/project-core/dist/index.js",
  "types": "./packages/project-core/dist/index.d.ts",
  "bin": {
    "tiangz-check-project": "./dist/tiangz-check-project.cjs"
  },
  "exports": {
    ".": {
      "types": "./packages/project-core/dist/index.d.ts",
      "import": "./packages/project-core/dist/index.js"
    }
  },
  "files": [
    "packages/project-core/dist/**",
    "dist/tiangz-check-project.cjs",
    "dist/tiangz-check-project.cjs.map",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "build:core": "tsc -p packages/project-core/tsconfig.json",
    "typecheck:cli": "tsc -p packages/project-cli/tsconfig.json",
    "build:cli": "node tools/build-cli.mjs",
    "build:extension": "npm run typecheck --workspace tiangz-developer-tools && npm run build --workspace tiangz-developer-tools",
    "test:core": "npm run build:core && node --test packages/project-core/test/*.test.mjs",
    "test:cli": "npm run typecheck:cli && npm run build:cli && node --test packages/project-cli/test/*.test.mjs",
    "test:server": "npm run build:extension && node --test extension/test/*.test.mjs",
    "check": "npm run test:core && npm run test:cli && npm run test:server && npm run check:package --workspace tiangz-developer-tools",
    "check:project": "npm run build:cli && node dist/tiangz-check-project.cjs",
    "prepare": "npm run build:core && npm run build:cli",
    "package:extension": "npm run package --workspace tiangz-developer-tools"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=20"
  }
}
