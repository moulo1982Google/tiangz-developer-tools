{
  "name": "tiangz-developer-tools",
  "displayName": "TiangZ Developer Tools",
  "description": "TiangZ Process、Scene、Component 与 Handler 工程工具",
  "version": "0.2.0",
  "publisher": "moulo",
  "author": "moulo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/eblard_admin/tiangz-developer-tools.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "activationEvents": [
    "onView:tiangzProject",
    "workspaceContains:configs",
    "workspaceContains:app/core"
  ],
  "main": "./dist/extension.cjs",
  "categories": [
    "Other"
  ],
  "keywords": [
    "TiangZ",
    "Scene",
    "Actor",
    "Component",
    "Handler"
  ],
  "files": [
    "dist/extension.cjs",
    "dist/extension.cjs.map",
    "dist/server.cjs",
    "dist/server.cjs.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node ../tools/build-extension.mjs",
    "check:package": "vsce ls --no-dependencies",
    "prepackage": "node -e \"require('node:fs').mkdirSync('../dist', { recursive: true })\"",
    "package": "npm run build && vsce package --no-dependencies --out ../dist/tiangz-developer-tools-0.2.0.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^3.6.2"
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "tiangzProject",
          "name": "TiangZ 工程"
        }
      ]
    },
    "commands": [
      {
        "command": "tiangzDeveloperTools.refreshProject",
        "title": "TiangZ：刷新工程索引",
        "icon": "$(refresh)"
      },
      {
        "command": "tiangzDeveloperTools.showProjectSummary",
        "title": "TiangZ：显示工程摘要"
      },
      {
        "command": "tiangzDeveloperTools.showServerStats",
        "title": "TiangZ：显示语言服务器状态"
      },
      {
        "command": "tiangzDeveloperTools.openLocation",
        "title": "TiangZ：打开声明"
      },
      {
        "command": "tiangzDeveloperTools.openUriLocation",
        "title": "TiangZ：打开协议位置"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tiangzDeveloperTools.refreshProject",
          "when": "view == tiangzProject",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tiangzDeveloperTools.openLocation",
          "when": "view == tiangzProject && viewItem == tiangzLocation",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "TiangZ Developer Tools",
      "properties": {
        "tiangzDeveloperTools.configRoot": {
          "type": "string",
          "default": "configs",
          "description": "TiangZ 启动配置相对于工作区的目录。"
        },
        "tiangzDeveloperTools.sourceRoots": {
          "type": "array",
          "default": [
            "app"
          ],
          "items": {
            "type": "string"
          },
          "description": "需要索引 Scene、Component 与 Handler 的 TypeScript 源码目录。"
        },
        "tiangzDeveloperTools.initialFileLimit": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "description": "每个工作区最多索引的配置和 TypeScript 文件数。"
        },
        "tiangzDeveloperTools.maxFileSizeBytes": {
          "type": "number",
          "default": 2097152,
          "minimum": 65536,
          "description": "单个配置或 TypeScript 文件允许索引的最大字节数。"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
