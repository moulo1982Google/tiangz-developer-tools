{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TiangZ Process 配置",
  "type": "object",
  "properties": {
    "process": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "当前 Process 的稳定名称。"
        },
        "identity": {
          "type": "object",
          "required": ["originServerId", "workerId"],
          "properties": {
            "originServerId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16383,
              "description": "永久服来源编号；合服后仍不能与其他来源服重复。"
            },
            "workerId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127,
              "description": "当前来源服内的 ID 生成节点编号。"
            }
          },
          "additionalProperties": false,
          "description": "GlobalId 生成槽位；同一 StartMachine 部署集合内必须唯一。"
        },
        "debug": {
          "type": "object",
          "properties": {
            "inspectorIp": { "type": "string" },
            "inspectorPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "breakOnStart": { "type": "boolean" },
            "allowRemote": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "knownScenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "knownSceneFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "共享稳定Scene目录文件，相对当前Process配置解析；用于避免每个进程重复knownScenes。"
    }
  },
  "required": ["process"],
  "additionalProperties": true,
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["name", "sceneType"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sceneType": { "type": "string", "minLength": 1 },
        "ip": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": {
          "type": "string",
          "enum": ["auto", "tcp", "websocket", "kcp"],
          "description": "该Scene端点使用的传输协议。"
        },
        "audience": {
          "type": "string",
          "enum": ["mixed", "inner", "outer"],
          "description": "端点面向内网、外网或混合流量。"
        },
        "staticMapIds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true,
          "description": "MapHost启动时固定创建的静态地图配置ID；空数组表示不承载静态地图。"
        },
        "acceptDynamicMaps": {
          "type": "boolean",
          "description": "MapHost是否注册MapManager并接受动态副本分配。"
        }
      },
      "additionalProperties": true
    }
  }
}
