{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TiangZ Process 配置",
  "type": "object",
  "properties": {
    "process": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "当前 Process 的稳定名称。"
        },
        "identity": {
          "type": "object",
          "required": ["originServerId", "workerId"],
          "properties": {
            "originServerId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16383,
              "description": "永久服来源编号；合服后仍不能与其他来源服重复。"
            },
            "workerId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127,
              "description": "当前来源服内的 ID 生成节点编号。"
            }
          },
          "additionalProperties": false,
          "description": "GlobalId 生成槽位；同一 StartMachine 部署集合内必须唯一。"
        },
        "debug": {
          "type": "object",
          "properties": {
            "inspectorIp": { "type": "string" },
            "inspectorPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "breakOnStart": { "type": "boolean" },
            "allowRemote": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "persistence": {
          "type": "object",
          "properties": {
            "dbProxy": {
              "type": "object",
              "required": ["endpoint"],
              "properties": {
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "DBProxy内网监听地址，例如127.0.0.1:7800。"
                },
                "authTokenEnv": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "default": "TIANGZ_DBPROXY_AUTH_TOKEN",
                  "description": "保存认证令牌的环境变量名；禁止在JSON中填写真实令牌。"
                },
                "clientPoolSize": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "default": 4,
                  "description": "当前Process到DBProxy的Rust连接池大小。"
                },
                "connectTimeoutMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 120000,
                  "default": 5000
                },
                "requestTimeoutMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 120000,
                  "default": 5000
                },
                "maxFrameBytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 67108864,
                  "default": 8388608,
                  "description": "单个DBProxy协议帧上限，必须与服务端一致。"
                }
              },
              "additionalProperties": false,
              "description": "启用独立DBProxy持久化；省略时由业务选择非DBProxy Repository。"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "knownScenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "knownSceneFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "共享稳定Scene目录文件，相对当前Process配置解析；用于避免每个进程重复knownScenes。"
    }
  },
  "required": ["process"],
  "additionalProperties": true,
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["name", "sceneType"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sceneType": { "type": "string", "minLength": 1 },
        "innerIp": {
          "type": "string",
          "description": "服务间通信地址；旧配置可使用 ip，但新配置应使用 innerIp。"
        },
        "bindIp": {
          "type": "string",
          "description": "本机监听地址；云服务器通常填写 0.0.0.0，不能作为服务路由或客户端地址。"
        },
        "outerIp": {
          "type": "string",
          "description": "客户端连接地址；LoginMgr/Login/Gate 返回该地址。"
        },
        "outerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "客户端连接端口；省略时沿用 port。"
        },
        "ip": {
          "type": "string",
          "description": "兼容旧配置的内网通信地址；新配置请使用 innerIp。"
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": {
          "type": "string",
          "enum": ["auto", "tcp", "websocket", "kcp"],
          "description": "该Scene端点使用的传输协议。"
        },
        "audience": {
          "type": "string",
          "enum": ["mixed", "inner", "outer"],
          "description": "端点面向内网、外网或混合流量。"
        },
        "staticMapIds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true,
          "description": "MapHost启动时固定创建的静态地图配置ID；空数组表示不承载静态地图。"
        },
        "acceptDynamicMaps": {
          "type": "boolean",
          "description": "MapHost是否注册MapManager并接受动态副本分配。"
        }
      },
      "additionalProperties": true
    }
  }
}
