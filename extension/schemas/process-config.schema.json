{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TiangZ Process 配置",
  "type": "object",
  "properties": {
    "process": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "当前 Process 的稳定名称。"
        },
        "identity": {
          "type": "object",
          "required": ["originServerId", "workerId"],
          "properties": {
            "originServerId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16383,
              "description": "永久服来源编号；合服后仍不能与其他来源服重复。"
            },
            "workerId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127,
              "description": "当前来源服内的 ID 生成节点编号。"
            }
          },
          "additionalProperties": false,
          "description": "GlobalId 生成槽位；同一 StartMachine 部署集合内必须唯一。"
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ioBackend": { "type": "string", "enum": ["epoll", "io-uring"], "default": "epoll" },
            "maxAcceptedConnections": {
              "type": "integer", "minimum": 1, "maximum": 1000000, "default": 65536,
              "description": "TiangZ 0.7 起支持。当前 Process 全部业务监听端口共享的已接受连接上限，包含未完成握手；KCP 在 cookie 校验后计入会话。超限立即拒绝，不排队。0.6.x 宿主不接受此字段。"
            },
            "maxPendingHandshakes": {
              "type": "integer", "minimum": 1, "maximum": 1000000, "default": 1024,
              "description": "TiangZ 0.7 起支持。当前 Process 全部流式业务监听端口共享的未完成握手上限；成功、失败或取消后归还名额。KCP 的无状态握手不占用此名额。0.6.x 宿主不接受此字段。"
            },
            "maxOutboundBufferedBytes": {
              "type": "integer", "minimum": 1, "maximum": 1073741824, "default": 67108864,
              "description": "TiangZ 0.7 起支持。当前 Process 的 ConnectionWriter payload 与主动 Inner Host 整包共享字节预算，覆盖复制后的待调度、排队与在途写出；广播按接收者、Inner 按整包保守累计。Writer 超限拒绝并关闭连接，Host 整包超限在复制/提交前拒绝。不含 RPC 响应、入站/V8、KCP 内部可靠缓存或整个进程内存。0.6.x 宿主不接受此字段。"
            },
            "maxIngressBufferedBytes": {
              "type": "integer", "minimum": 1, "maximum": 1073741824, "default": 67108864,
              "description": "TiangZ 0.7 起支持。全部业务 listener 已解码 Rust Process 入站帧共享逻辑字节额度，包含 Inner RPC、等待帧数空位和热更延后帧；最后引用释放才归还。超限时 Inner RPC 返回入口过载，外部/单向来源关闭。Disconnect/Shutdown/Host completion 不占本项帧额度。不含解码器、Host 打包副本、V8/TS mailbox 或 KCP 可靠缓存。0.6.x 宿主不接受此字段。"
            },
            "maxKcpBufferedBytes": {
              "type": "integer", "minimum": 1, "maximum": 1073741824, "default": 67108864,
              "description": "TiangZ 0.7 起支持。全部 KCP listener 共享的保守 C 缓存/输出字节额度，覆盖发送接收段、未确认数据、ACK 保留容量和最后一个输出引用；每 Session 另限 4 MiB。扩容前预留，纯 ACK 在满额度时仍可释放缓存；超限或输出回调失败只关闭对应 Session。不是进程总内存，不含接收/UDP 封包副本、Rust 容器或 V8。0.6.x 宿主不接受此字段。"
            },
            "backend": { "type": "string", "enum": ["epoll", "io-uring"], "deprecationMessage": "请使用 ioBackend。" },
            "uringEntries": { "type": "integer", "enum": [64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768], "default": 1024 },
            "uringReadBufferBytes": { "type": "integer", "minimum": 4096, "maximum": 1048576, "default": 65536 },
            "writeTimeoutMs": {
              "type": "integer", "minimum": 1, "maximum": 300000, "default": 10000,
              "description": "TiangZ 0.7 起支持。出站批次从 writer 准入、排队到 TCP/WebSocket 完整写出的总期限；主动 Inner 同时受操作期限约束。过期或部分写失败结束该字节流。KCP 仅约束交给可靠传输前的排队。0.6.x 宿主不接受此字段。"
            }
          }
        },
        "debug": {
          "type": "object",
          "properties": {
            "inspectorIp": { "type": "string" },
            "inspectorPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "breakOnStart": { "type": "boolean" },
            "allowRemote": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "persistence": {
          "type": "object",
          "properties": {
            "dbProxy": {
              "type": "object",
              "required": ["endpoint"],
              "properties": {
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "DBProxy内网监听地址，例如127.0.0.1:7800。"
                },
                "failoverEndpoints": {
                  "type": "array",
                  "maxItems": 7,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "description": "按顺序尝试的DBProxy备用内网地址；只有网络不可用时切换。"
                },
                "authTokenEnv": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                  "default": "TIANGZ_DBPROXY_AUTH_TOKEN",
                  "description": "保存认证令牌的环境变量名；禁止在JSON中填写真实令牌。"
                },
                "clientPoolSize": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64,
                  "default": 4,
                  "description": "当前Process到DBProxy的Rust连接池大小。"
                },
                "connectTimeoutMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 120000,
                  "default": 5000
                },
                "requestTimeoutMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 120000,
                  "default": 5000
                },
                "maxFrameBytes": {
                  "type": "integer",
                  "minimum": 1024,
                  "maximum": 67108864,
                  "default": 8388608,
                  "description": "单个DBProxy协议帧上限，必须与服务端一致。"
                }
              },
              "additionalProperties": false,
              "description": "启用独立DBProxy持久化；省略时由业务选择非DBProxy Repository。"
            }
          },
          "additionalProperties": false
        },
        "observability": {
          "type": "object",
          "properties": {
            "latency": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean", "default": false },
                "sampleRate": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1,
                  "description": "延迟指标采样率；必须大于0。"
                }
              },
              "additionalProperties": false
            },
            "health": {
              "type": "object",
              "required": ["port"],
              "properties": {
                "ip": { "type": "string", "default": "127.0.0.1" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "staleAfterMs": { "type": "integer", "minimum": 10000, "default": 15000 }
              },
              "additionalProperties": false
            },
            "nativeData": {
              "type": "object",
              "properties": {
                "debugScalarAccess": {
                  "type": "boolean",
                  "default": false,
                  "description": "达到阈值时记录Native标量Get/Set访问告警，不会限制业务调用。"
                },
                "scalarAccessWarnThreshold": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295,
                  "default": 10000,
                  "description": "单个采样窗口内触发标量访问告警的次数阈值。"
                }
              },
              "additionalProperties": false,
              "description": "由Rust Core校验的Native Store诊断配置。"
            }
          },
          "additionalProperties": false
        },
        "nativeData": false
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "knownScenes": {
      "type": "array",
      "items": { "$ref": "#/$defs/scene" }
    },
    "knownSceneFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "共享稳定Scene目录文件，相对当前Process配置解析；用于避免每个进程重复knownScenes。"
    }
  },
  "required": ["process"],
  "additionalProperties": true,
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["name", "sceneType"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sceneType": { "type": "string", "minLength": 1 },
        "innerIp": {
          "type": "string",
          "description": "服务间通信地址；旧配置可使用 ip，但新配置应使用 innerIp。"
        },
        "bindIp": {
          "type": "string",
          "description": "本机监听地址；云服务器通常填写 0.0.0.0，不能作为服务路由或客户端地址。"
        },
        "outerIp": {
          "type": "string",
          "description": "客户端连接地址；LoginMgr/Login/Gate 返回该地址。"
        },
        "outerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "客户端连接端口；省略时沿用 port。"
        },
        "ip": {
          "type": "string",
          "description": "兼容旧配置的内网通信地址；新配置请使用 innerIp。"
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": {
          "type": "string",
          "enum": ["auto", "tcp", "websocket", "kcp"],
          "description": "该Scene端点使用的传输协议。"
        },
        "audience": {
          "type": "string",
          "enum": ["mixed", "inner", "outer"],
          "description": "端点面向内网、外网或混合流量。"
        },
        "staticMapIds": {
          "deprecated": true,
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "uniqueItems": true,
          "description": "旧版 MapHost 静态地图部署字段。0.7 改用 MMORPG 模块部署数据包；过渡期显式双写必须与模块值一致，冲突拒绝启动。旧部署仍支持本字段。"
        },
        "acceptDynamicMaps": {
          "deprecated": true,
          "type": "boolean",
          "description": "旧版 MapHost 动态地图开关。0.7 改用 MMORPG 模块部署数据包；过渡期显式双写必须一致，缺失时保留旧默认 false。旧部署仍支持本字段。"
        }
      },
      "additionalProperties": true
    }
  }
}
