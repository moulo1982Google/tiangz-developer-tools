{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TiangZ 共享Scene目录",
  "type": "object",
  "required": ["knownScenes"],
  "properties": {
    "knownScenes": {
      "type": "array",
      "description": "稳定启动Scene目录；动态MapHost通过MapManager注册，不写入这里。",
      "items": {
        "type": "object",
        "required": ["name", "sceneType", "ip", "port"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sceneType": { "type": "string", "minLength": 1 },
          "ip": { "type": "string", "minLength": 1 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "protocol": { "type": "string", "enum": ["auto", "tcp", "websocket", "kcp"] },
          "audience": { "type": "string", "enum": ["mixed", "inner", "outer"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
